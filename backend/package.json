{
  "name": "smb-recon-tool-backend",
  "version": "1.0.0",
  "description": "SMB Automated Recon Tool Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --delay 500ms src/server.js",
    "check-deps": "node -e \"console.log('Checking masscan and smbclient...'); process.exit(require('child_process').execSync('which masscan smbclient > /dev/null 2>&1').status)\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "smb2": "^0.2.11",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "smb",
    "recon",
    "security",
    "automation"
  ],
  "author": "",
  "license": "MIT"
}
